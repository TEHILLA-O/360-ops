# OpsPilot 365 — copy to .env and fill only on a machine you control.
# Never commit a populated .env. The React app must not receive the client secret.

OPSPILOT_ENV=local
OPSPILOT_AUTH_MODE=local_synthetic
OPSPILOT_DATA_DIR=./data
OPSPILOT_SEED=true
OPSPILOT_SUPPORT_MAILBOX=servicedesk@northstar.example
OPSPILOT_COMPANY_TIMEZONE=Europe/London
OPSPILOT_ALLOW_LOCAL_APPROVAL_SIMULATION=true

# Leave blank until an Entra app registration exists.
# Delegated scopes used by the service: User.Read, Mail.ReadBasic, Files.Read, Calendars.ReadWrite
OPSPILOT_AZURE_TENANT_ID=
OPSPILOT_AZURE_CLIENT_ID=
OPSPILOT_AZURE_CLIENT_SECRET=
OPSPILOT_AZURE_REDIRECT_URI=http://localhost:8090/auth/callback
OPSPILOT_PUBLIC_APP_URL=http://localhost:5173

# Optional. When empty, Teams notifications are recorded as not delivered.
OPSPILOT_TEAMS_WEBHOOK_URL=

OPSPILOT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
